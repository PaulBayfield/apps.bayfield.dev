# Copy to server/.env for local runs, or pass these to the container.

# Where Apps is reachable (OIDC redirect).
PUBLIC_URL=https://apps.bayfield.dev
PORT=8791

# Encrypts the session cookies. At least 32 characters: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=
# Days a sign-in lasts.
# SESSION_DAYS=30

# The public apps everyone sees (signed in or not). Edits apply without a restart.
# APPS_FILE=../config/apps.json

# --- Sign in with Authentik (off when unset: only the public apps are listed) ---
# Authentik: Applications → Providers → OAuth2/OpenID, confidential client,
# redirect URI ${PUBLIC_URL}/api/auth/oidc/callback, scopes openid profile email.
# The issuer is the provider's "OpenID Configuration Issuer", e.g. https://auth.example.com/application/o/apps/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik

# The Authentik API, to list the applications each user may open, show their profile and set
# their password. Directory → Tokens and App passwords → Create (intent: API) for a service
# account with these permissions: view users, view user applications, reset user passwords
# (or make the service account a superuser). To show which groups give access to each app:
# view group and view policy binding. For two-factor: view and delete TOTP and WebAuthn
# devices (and view Static devices to list recovery codes).
AUTHENTIK_TOKEN=
# Defaults to the issuer's origin. Keep it on the issuer's host: two-factor setup relies on it.
# AUTHENTIK_URL=https://auth.example.com
# The flows users add an authenticator app or a passkey with.
# AUTHENTIK_TOTP_FLOW=default-authenticator-totp-setup
# AUTHENTIK_WEBAUTHN_FLOW=default-authenticator-webauthn-setup

# Changing the password needs a sign-in at most this many minutes old; older ones confirm at Authentik first.
# REAUTH_MINUTES=10
# PASSWORD_MIN_LENGTH=8

# Local development without Authentik: sign straight in as this user, with sample private apps.
# Only honoured when PUBLIC_URL is http://localhost; leave unset everywhere else.
# DEV_LOGIN_USER=demo

# Header your reverse proxy puts the visitor IP in, used for rate limiting
# (behind a Cloudflare Tunnel: cf-connecting-ip). Leave unset if the port is reachable without the proxy.
# CLIENT_IP_HEADER=cf-connecting-ip

# Look on GitHub for a newer release, shown in Settings → About (cached for 6 hours).
# Set false if the server shouldn't make outbound requests.
# UPDATE_CHECK=true
